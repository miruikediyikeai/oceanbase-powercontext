# Copy to .env for scripts/run_local.py or Docker Compose.
CABINET_TOKEN=replace-with-a-random-service-token
POWERCONTEXT_URL=http://127.0.0.1:8811
POWERCONTEXT_TOKEN=
# Compose defaults an empty POWERCONTEXT_TOKEN to CABINET_TOKEN for its private memory server.
# You may set a distinct random token; init_local_config.py does so for new installations.
DIFY_API_URL=http://host.docker.internal:5001/v1
DIFY_APP_KEY=
# Optional OpenAI-compatible narration. Leave all three empty for rule mode.
NARRATOR_BASE_URL=
NARRATOR_MODEL=
NARRATOR_API_KEY=
# Optional dedicated local Dify stack (compose.dify.yaml).
# scripts/init_local_config.py generates these for a fresh .env without printing secrets.
DIFY_SECRET_KEY=replace-with-random-secret
DIFY_DB_PASSWORD=replace-with-random-password
DIFY_REDIS_PASSWORD=replace-with-random-password
DIFY_SANDBOX_KEY=replace-with-random-secret
DIFY_PLUGIN_KEY=replace-with-random-secret
DIFY_PLUGIN_INNER_KEY=replace-with-random-secret
DIFY_ADMIN_EMAIL=admin@example.com
DIFY_ADMIN_PASSWORD=replace-with-long-password-containing-letters-and-digits
